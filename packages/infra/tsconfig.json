{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "declaration": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "alwaysStrict": true,
    "outDir": "./dist",
    "rootDir": "./lib",
    "inlineSourceMap": true,
    "inlineSources": true,
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "cdk.out"]
}
