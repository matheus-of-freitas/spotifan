{
  "name": "spotifan",
  "private": true,
  "scripts": {
    "dev:frontend": "pnpm --filter @spotifan/frontend dev",
    "dev:backend": "pnpm --filter @spotifan/backend dev",
    "build": "pnpm -r run build",
    "build:frontend": "pnpm --filter @spotifan/frontend build",
    "build:backend": "pnpm --filter @spotifan/backend build",
    "build:infra": "pnpm --filter @spotifan/infra build",
    "test": "pnpm -r run test",
    "test:backend": "pnpm --filter @spotifan/backend test",
    "test:frontend": "pnpm --filter @spotifan/frontend test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.58.2",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0"
  }
}
